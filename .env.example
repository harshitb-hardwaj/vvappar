# Firebase (client + server verification)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=

# API
NEXT_PUBLIC_API_URL=http://localhost:8787
PORT=8787
DEV_BYPASS_AUTH=true
# Set DEV_BYPASS_AUTH=false in production

# Turso / libSQL — local file works out of the box; set these for Turso cloud
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# Cloudflare
# R2_BUCKET=invoices-assets (future: logos + PDFs)
